{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Run HelloWorld",
            "request": "launch",
            "mainClass": "com.example.HelloWorld",
            "projectName": "java-ui",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen"
        },
        {
            "type": "java",
            "name": "Debug HelloWorld",
            "request": "launch",
            "mainClass": "com.example.HelloWorld",
            "projectName": "java-ui",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "stopOnEntry": false
        },
        {
            "type": "java",
            "name": "Run Current File",
            "request": "launch",
            "mainClass": "${file}",
            "projectName": "java-ui",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen"
        }
    ]
}